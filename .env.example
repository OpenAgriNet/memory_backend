# Copy to .env (ignored by git). Process environment overrides this file.
# Set AMUL_MEMORY_ENV_FILE to select another file for an isolated deployment.
QDRANT_URL=https://qdrant.your-host.internal
QDRANT_API_KEY=
QDRANT_COLLECTION=amul_memory_synthetic_v1
# Worker progress only; must never be the farmer-memory collection.
QDRANT_TASK_STATE_COLLECTION=amul_memory_task_state_v1
# Claim lifetime; expired pre-write work can be retried, uncertain writes require review.
MEMORY_TASK_LEASE_SECONDS=900
MARQO_URL=
MARQO_INDEX=amul-veterinary-index
EMBED_DIM=1024
DREAMER_PROVIDER=vllm
DREAMER_BASE_URL=
DREAMER_MODEL=gemma-4-31b-it
MEMORY_API_URL=http://127.0.0.1:8105
# Source for the next background run. Set all three for the intended project.
LANGFUSE_BASE_URL=https://langfuse.your-host.internal
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Closed-session producer. It reads the current amul-oan-api/main telemetry
# contract: chat.translation + chat.turn.v1 + metadata user_id/persona.
MEMORY_SESSION_CLOSE_SECONDS=2400
MEMORY_SCAN_INTERVAL_SECONDS=1800
MEMORY_DISCOVERY_LOOKBACK_SECONDS=86400
MEMORY_SESSION_LOOKBACK_DAYS=30
# Safe rollout defaults: observe only and select nobody.
MEMORY_PRODUCER_DRY_RUN=true
MEMORY_FARMER_ALLOWLIST_ENABLED=true
MEMORY_FARMER_ALLOWLIST=
# After the allowlisted test is accepted, set the flag above to false to scan
# every eligible farmer. The list can remain populated for rollback.
MEMORY_REDIS_URL=redis://localhost:6379/0
MEMORY_QUEUE_STREAM=amul:memory:tasks:v1
MEMORY_QUEUE_DLQ_STREAM=amul:memory:tasks:dead:v1
MEMORY_QUEUE_CONSUMER_GROUP=memory-workers-v1
MEMORY_QUEUE_CONSUMER_NAME=memory-worker-1
MEMORY_QUEUE_DEDUPE_PREFIX=amul:memory:task-published:v1
MEMORY_QUEUE_REVISION_PREFIX=amul:memory:session-revision:v1
MEMORY_QUEUE_RETRY_SET=amul:memory:tasks:retry:v1
MEMORY_QUEUE_VISIBILITY_SECONDS=900
MEMORY_QUEUE_MAX_ATTEMPTS=5
MEMORY_QUEUE_RETRY_BASE_SECONDS=60
MEMORY_QUEUE_RETRY_MAX_SECONDS=900
MEMORY_QUEUE_BLOCK_MS=5000
MEMORY_QUEUE_MAX_LENGTH=100000
MEMORY_QUEUE_DEDUPE_SECONDS=2592000
BACKTEST_API_URL=http://127.0.0.1:8105
BACKTEST_COLLECTION=amul_memory_synthetic_v1
