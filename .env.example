# Copy to .env (ignored by git). Process environment overrides this file.
# Set AMUL_MEMORY_ENV_FILE to select another file for an isolated deployment.
QDRANT_URL=https://qdrant.your-host.internal
QDRANT_API_KEY=
QDRANT_COLLECTION=amul_memory_synthetic_v1
# Embeddings run in-process (FastEmbed); first use downloads the model unless cached.
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_DIM=1024
DREAMER_PROVIDER=vllm
DREAMER_BASE_URL=
DREAMER_MODEL=gemma-4-31b-it
MEMORY_API_URL=http://127.0.0.1:8105
# Bearer token shared by the Memory API, the worker and the bot. Long random value.
MEMORY_INTERNAL_TOKEN=
# Worker (dreamer/worker.py): high-water mark collection, cadence, and who to process.
MEMORY_WORKER_STATE_COLLECTION=amul_memory_worker_state
MEMORY_SCAN_INTERVAL_SECONDS=1800
MEMORY_SETTLE_SECONDS=2400
MEMORY_FIRST_LOOKBACK_SECONDS=86400
# Comma-separated phones; empty = every eligible farmer.
MEMORY_FARMER_ALLOWLIST=
# Source for the next background run. Set all three for the intended project.
LANGFUSE_BASE_URL=https://langfuse.your-host.internal
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
BACKTEST_API_URL=http://127.0.0.1:8105
BACKTEST_COLLECTION=amul_memory_synthetic_v1
